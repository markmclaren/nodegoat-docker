# Copy to .env and change the passwords
MARIADB_ROOT_PASSWORD=change-me-root
DB_CMS_PASSWORD=change-me-cms
DB_HOME_PASSWORD=change-me-home

# Host port for the web server (keep 80 if you can; see README)
HTTP_PORT=80

# production or development (development displays PHP errors)
APP_STATE=production

# 1 = compile the nodegoat Network Analysis service (slow first build)
WITH_GRAPH_ANALYSIS=0
