# Copy to .env and change the passwords
MARIADB_ROOT_PASSWORD=change-me-root
DB_CMS_PASSWORD=change-me-cms
DB_HOME_PASSWORD=change-me-home

# Host port for the web server (keep 80 if you can; see README)
HTTP_PORT=80

# production or development (development displays PHP errors)
APP_STATE=production

# 1 = compile the nodegoat Network Analysis service (slow first build)
WITH_GRAPH_ANALYSIS=0

# Test accounts, created on container start if they do not exist yet (leave a password empty to skip)
# CMS (http://cms.nodegoat.localhost) CORE admin
CMS_ADMIN_USER=admin
CMS_ADMIN_PASSWORD=admin
# nodegoat (http://nodegoat.localhost) user with Admin clearance and Management/Model pages
NODEGOAT_USER=test
NODEGOAT_PASSWORD=test
NODEGOAT_EMAIL=test@nodegoat.localhost

# 0 = do not schedule the 1100CC Jobs process on start
JOBS_AUTOSTART=1

# 1 = create the 'Hello nodegoat' demo project (City, Person, Letter) on start if it does not exist
SEED_DEMO=1
